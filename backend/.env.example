PORT=8000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
NEON_AUTH_BASE_URL="https://ep-example.neonauth.region.aws.neon.tech/neondb/auth"
FRONTEND_ORIGIN="http://localhost:5173"

# Per-client-IP limits for /api/documents, counted per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_VERSION_MAX=20
RATE_LIMIT_READ_MAX=300

# Number of reverse-proxy hops in front of the app. Leave unset to use 1 on Render
# (detected via RENDER=true) and 0 elsewhere. Never set this higher than the real hop count.
# TRUST_PROXY=1
